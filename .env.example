# Supabase > Connect > Connection string > URI > "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD]; URL-encode any @ # / ? : % characters in the password.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=require
# The real deployed address, no trailing slash, e.g. https://bey-checker.vercel.app
SITE_URL=https://your-domain.example
# Long random strings (at least 16 characters each).
CRON_SECRET=change-me-long-random-string
SETUP_TOKEN=change-me-another-long-random-string
# Upload limit per request; keep 4 on Vercel (it rejects bodies above about 4.5 MB).
MAX_UPLOAD_MB=4
